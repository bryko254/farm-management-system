# Copy to .env and edit. Never commit .env.
DJANGO_SECRET_KEY=change-me-generate-with-python-c-"from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=farm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://farm.example.com
# Postgres in production; omit to use local sqlite
DATABASE_URL=postgres://farm:farm@db:5432/farm
# Set to False only when running behind plain HTTP (e.g. local docker)
DJANGO_SECURE_SSL=True
# Disable open self-registration in production if you want invite-only
DJANGO_ALLOW_REGISTRATION=True
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
